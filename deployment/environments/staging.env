# Copy this template and store secrets in your vault/CI

POSTGRES_DB=tracetrail_staging
POSTGRES_USER=tracetrail_staging
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

APP_NAME=TraceTrail API
APP_VERSION=1.0.0
ENVIRONMENT=staging
SECRET_KEY=replace-with-staging-secret
CORS_ORIGINS=https://staging.tracetrail.com
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
EXTENSION_ENABLED=true
EXTENSION_WEBSOCKET_ENABLED=true

BACKEND_PORT=8000
FRONTEND_PORT=5173
AI_PORT=8100
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
VITE_API_BASE_URL=https://api.staging.tracetrail.com
