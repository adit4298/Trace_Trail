# AI module Dockerfile

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/*

COPY ai_module/requirements.txt requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt && rm requirements.txt

COPY ai_module/ .

RUN useradd -r -u 1002 aiuser && chown -R aiuser:aiuser /app
USER aiuser

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -fsS http://localhost:8100/ || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8100"]
