{
  "root": true,
  "env": {
    "browser": true,
    "es2023": true,
    "webextensions": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "sourceType": "module",
    "ecmaVersion": 2023
  },
  "globals": {
    "chrome": "readonly"
  },
  "ignorePatterns": ["dist/", "node_modules/"],
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^ignored" }],
    "no-console": ["off"]
  }
}

