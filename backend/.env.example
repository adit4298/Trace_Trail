# Application
APP_NAME=TraceTrail API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
SHOW_DOCS=true

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trace_trail
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/trace_trail
DB_ECHO=false

# Security
SECRET_KEY=change-me

# CORS
CORS_ORIGINS=http://localhost:3000
